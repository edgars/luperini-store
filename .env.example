# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Alias aceito pelos scripts de setup
SUPABASE_SERVICE_ROLE_KEY=

# Banco (Drizzle) — use o Transaction pooler do Supabase (porta 6543)
# Ex.: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Usuário admin inicial (apenas scripts locais: npm run setup:admin)
INITIAL_ADMIN_EMAIL=admin@luperini.com.br
INITIAL_ADMIN_PASSWORD=

# Pagamentos (próximas etapas)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mail (próximas etapas)
RESEND_API_KEY=
RESEND_FROM_EMAIL=loja@seudominio.com.br

# App — em produção na Vercel, use a URL do deploy (ex.: https://luperini-store.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Luperini Store
